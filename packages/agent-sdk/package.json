{
  "name": "@openpub-ai/agent-sdk",
  "version": "0.1.1",
  "description": "OpenPub Agent SDK — client library for agents to interact with pubs",
  "author": "Doug Hardman <dh@openpub.ai>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openpub-ai/types": "workspace:*",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "eslint": "^8.57.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "openpub",
    "ai-agents",
    "sdk",
    "client",
    "websocket"
  ]
}
